# X-MAS production env — copy to infra/.env and fill in.
# infra/.env is gitignored. NEVER commit real secrets (QPay, R2, DB password).

# --- Database ---
# On-box Postgres (docker-compose.prod.yml) — set these three:
POSTGRES_USER=xmas
# MUST be URL-safe: the compose file builds DATABASE_URL by pasting this
# straight into postgres://user:PASSWORD@postgres:5432/db. A "/" or "@" in it
# ends the URL's authority early and Medusa then tries to resolve a host that
# does not exist. Generate with `openssl rand -hex 32` — NOT `-base64`,
# which emits "/" and "=".
POSTGRES_PASSWORD=change-me-run-openssl-rand-hex-32
POSTGRES_DB=xmas
# Managed Postgres (docker-compose.managed-db.yml) — set the FULL connection
# string instead (from Neon/DO). Must include ?sslmode=require. Leave blank when
# using the on-box compose above.
DATABASE_URL=

# --- Medusa secrets (generate: openssl rand -base64 32 — these are never
# placed in a URL, so base64 is fine here) ---
JWT_SECRET=change-me
COOKIE_SECRET=change-me

# --- Admin RBAC hardening (recommended) ---
# Comma-separated emails that stay full super-admin even without a role. When SET,
# any other admin WITHOUT an assigned role is DENIED custom admin routes
# (deny-by-default). Leave BLANK to keep the no-lockout default (role-less = full
# access). Set this to your own admin email(s) once real staff roles are assigned.
SUPER_ADMIN_EMAILS=

# --- MeiliSearch (use a strong admin/master key) ---
MEILISEARCH_API_KEY=change-me-meili-master-key

# --- Public domains allowed to call Medusa (comma-separated, https) ---
STORE_CORS=https://xmas.mn,https://www.xmas.mn
ADMIN_CORS=https://admin.xmas.mn,https://api.xmas.mn
AUTH_CORS=https://xmas.mn,https://www.xmas.mn,https://admin.xmas.mn

# --- Storefront build-time public config ---
# NEXT_PUBLIC_MEDUSA_URL = the PUBLIC Medusa domain the browser hits.
NEXT_PUBLIC_MEDUSA_URL=https://api.xmas.mn
# Publishable key + region id from your seeded DB (SELECT token FROM api_key; SELECT id FROM region;).
NEXT_PUBLIC_MEDUSA_PK=pk_replace_me
NEXT_PUBLIC_MEDUSA_REGION=reg_replace_me
NEXT_PUBLIC_MEILISEARCH=1

# --- Express payment gateway (Botxon → QPay & bank apps) ---
# Public storefront origin (used for post-payment redirects).
PUBLIC_SITE_URL=https://xmas.mn
# Botxon (https://botxon.chat) — the ACTIVE gateway; money lands in the
# merchant's own QPay account. REQUIRED in production: the `api` service refuses
# to boot with a blank BOTXON_GATEWAY_KEY (blank = mock, auto-"pays" — dev only).
# Get both values from Botxon's /owner/gateway page.
# Webhook URL to register at Botxon: https://xmas.mn/api/webhooks/botxon
BOTXON_GATEWAY_URL=https://botxon.chat
BOTXON_GATEWAY_KEY=
# REQUIRED in live mode — the webhook refuses unsigned callbacks without it.
BOTXON_WEBHOOK_SECRET=
# Legacy Wire gateway — no longer used by checkout; leave blank.
WIRE_SECRET_KEY=
WIRE_WEBHOOK_SECRET=
# Email (Resend) — order confirmations + password-reset. Blank → emails log-only
# (mock). Consumed by BOTH the api service and the Medusa server/worker.
RESEND_API_KEY=
EMAIL_FROM=X-MAS <onboarding@resend.dev>
# Storefront base URL for password-reset links emailed by Medusa. MUST be your
# real domain in production, or reset links point to localhost.
STOREFRONT_URL=https://xmas.mn

# --- Optional: Cloudflare R2 image storage (blank → local files) ---
S3_FILE_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Analytics (optional; blank → disabled) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Error monitoring (Sentry, optional) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
